# development | production
NODE_ENV=development
PORT=3000

# Local MongoDB, or a MongoDB Atlas connection string.
# Special characters in the password must be URL-encoded (e.g. @ → %40).
MONGODB_URI=mongodb://127.0.0.1:27017/goldencare
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/goldencare?retryWrites=true&w=majority

# Set to true when the site is served over HTTPS (enables HSTS and upgrade-insecure-requests)
HTTPS=false

# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Nginx, …)
TRUST_PROXY=

# Max API requests per minute per IP
API_RATE_LIMIT=300
